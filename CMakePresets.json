    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "displayName": "Build UndefinedBehaviorSanitizer (UBSan)",
      "description": "Build targets for configure preset ${configurePresetName}"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "displayName": "Build ThreadSanitizer (TSan)",
      "description": "Build targets for configure preset ${configurePresetName}"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "displayName": "Build LLVM Source-Based Coverage",
      "description": "Build targets for configure preset ${configurePresetName}"
    },
    {
      "name": "benchmark",
      "configurePreset": "benchmark",
      "displayName": "Build Google Benchmark (Release, Optimized, Local Only)",
      "description": "Build targets for configure preset ${configurePresetName}"
    },
    {
      "name": "interop-debug",
      "configurePreset": "interop-debug",
      "displayName": "Build Crubit Interop Debug",
      "description": "Build targets for configure preset ${configurePresetName}"
    },
    {
      "name": "interop-release",
      "configurePreset": "interop-release",
      "displayName": "Build Crubit Interop Release",
      "description": "Build targets for configure preset ${configurePresetName}"
    },
    {
      "name": "sysroot-release",
      "configurePreset": "sysroot-release",
      "displayName": "Build Air-Gapped Sysroot Release",
      "description": "Build targets for configure preset ${configurePresetName}"
    },
    {
      "name": "cross-aarch64",
      "configurePreset": "cross-aarch64",
      "displayName": "Build Cross Linux AArch64",
      "description": "Build targets for configure preset ${configurePresetName}"
    },
    {
      "name": "cross-riscv64",
      "configurePreset": "cross-riscv64",
      "displayName": "Build Cross Linux RISC-V 64 (RVA23)",
      "description": "Build targets for configure preset ${configurePresetName}"
    }
  ],
  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "displayName": "Run Tests (Developer Debug (ASan + UBSan + clang-tidy))",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${configurePresetName}/junit.xml"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "GTEST_BRIEF": "1"
      }
    },
    {
      "name": "ci-debug",
      "configurePreset": "ci-debug",
      "displayName": "Run Tests (CI Debug (ASan + UBSan, no clang-tidy))",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${configurePresetName}/junit.xml"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "GTEST_BRIEF": "1"
      }
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "displayName": "Run Tests (Developer Release (Optimized, LTO))",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${configurePresetName}/junit.xml"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "GTEST_BRIEF": "1"
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "displayName": "Run Tests (AddressSanitizer (ASan))",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${configurePresetName}/junit.xml"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "GTEST_BRIEF": "1"
      }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "displayName": "Run Tests (UndefinedBehaviorSanitizer (UBSan))",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${configurePresetName}/junit.xml"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "GTEST_BRIEF": "1"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "displayName": "Run Tests (ThreadSanitizer (TSan))",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${configurePresetName}/junit.xml"
      },
      "filter": {
        "exclude": {
          "name": "^(NumberOfIslandsTest\\.MaxConstraintsGrid|LruCacheTest\\.StressTest)$"
        }
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "GTEST_BRIEF": "1"
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "displayName": "Run Tests (LLVM Source-Based Coverage)",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${configurePresetName}/junit.xml"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "GTEST_BRIEF": "1",
        "LLVM_PROFILE_FILE": "${sourceDir}/build/${configurePresetName}/profraw/%p-%m.profraw"
      }
    },
    {
      "name": "sysroot-release",
      "configurePreset": "sysroot-release",
      "displayName": "Run Tests (Air-Gapped Sysroot Release)",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${configurePresetName}/junit.xml"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "GTEST_BRIEF": "1"
      }
    },
    {
      "name": "interop-debug",
      "configurePreset": "interop-debug",
      "displayName": "Run Crubit Interop Tests (Debug)",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${configurePresetName}/junit.xml"
      },
      "execution": {
        "noTestsAction": "ignore",
        "stopOnFailure": false
      }
    },
    {
      "name": "interop-release",
      "configurePreset": "interop-release",
      "displayName": "Run Crubit Interop Tests (Release)",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/${configurePresetName}/junit.xml"
      },
      "execution": {
        "noTestsAction": "ignore",
        "stopOnFailure": false
      }
    }
  ],
