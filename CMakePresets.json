{
  "version": 13,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 5,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "warnings": {
        "author": true,
        "deprecated": true,
        "policy": true,
        "strict": true,
        "nonTargetDirective": true,
        "installAbsoluteDestination": true,
        "uninitialized": true,
        "unusedCli": true
      },
      "errors": {
        "nonTargetDirective": true,
        "deprecated": true
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_VERIFY_INTERFACE_HEADER_SETS": "ON",
        "BUILD_TESTING": "ON",
        "WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "pixi-base",
      "hidden": true,
      "inherits": "base",
      "description": "Inherits base when running inside an activated Pixi ($CONDA_PREFIX) shell",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{CONDA_PREFIX}",
        "rhs": ""
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{CONDA_PREFIX}/bin/clang",
        "CMAKE_CXX_COMPILER": "$env{CONDA_PREFIX}/bin/clang++",
        "CMAKE_PREFIX_PATH": "$env{CONDA_PREFIX}"
      }
    },
    {
      "name": "dev-debug",
      "inherits": "pixi-base",
      "displayName": "Developer Debug (ASan + UBSan + clang-tidy)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "ENABLE_SANITIZER_UNDEFINED": "ON"
      }
    },
    {
      "name": "ci-debug",
      "inherits": "pixi-base",
      "displayName": "CI Debug (ASan + UBSan, no clang-tidy)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "ENABLE_SANITIZER_UNDEFINED": "ON",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "dev-release",
      "inherits": "pixi-base",
      "displayName": "Developer Release (Optimized, LTO, SPDX SBOM)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_IPO": "ON",
        "CMAKE_INSTALL_SBOM_FORMATS": "spdx-3.0.1+json"
      }
    },
    {
      "name": "asan",
      "inherits": "pixi-base",
      "displayName": "AddressSanitizer (ASan)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZER_ADDRESS": "ON"
      }
    },
    {
      "name": "ubsan",
      "inherits": "pixi-base",
      "displayName": "UndefinedBehaviorSanitizer (UBSan)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZER_UNDEFINED": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "pixi-base",
      "displayName": "ThreadSanitizer (TSan)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZER_THREAD": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "pixi-base",
      "displayName": "LLVM Source-Based Coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "benchmark",
      "inherits": "pixi-base",
      "displayName": "Google Benchmark (Release, Optimized, Local Only)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_IPO": "ON",
        "BUILD_TESTING": "OFF",
        "BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "interop-debug",
      "inherits": "pixi-base",
      "displayName": "Crubit Interop Debug (C++23 libc++ <-> Rust 2024)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_LEET_CODE": "OFF",
        "BUILD_SYSTEMS": "OFF",
        "BUILD_INTEROP": "ON",
        "BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "interop-release",
      "inherits": "pixi-base",
      "displayName": "Crubit Interop Release (C++23 libc++ <-> Rust 2024, LTO)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_IPO": "ON",
        "BUILD_LEET_CODE": "OFF",
        "BUILD_SYSTEMS": "OFF",
        "BUILD_INTEROP": "ON",
        "BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "sysroot-release",
      "inherits": "base",
      "displayName": "Air-Gapped Sysroot Release (IPO + SPDX SBOM)",
      "description": "Standalone release preset without $CONDA_PREFIX for air-gapped or host SDK sysroot builds",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_IPO": "ON",
        "ALLOW_NON_PIXI_TOOLCHAIN": "ON",
        "CMAKE_INSTALL_SBOM_FORMATS": "spdx-3.0.1+json"
      }
    },
    {
      "name": "cross-aarch64",
      "inherits": "base",
      "displayName": "Cross-Compile Linux AArch64",
      "description": "Cross-compile Linux AArch64 release artifacts without host Pixi prefix leakage",
      "toolchainFile": "${fileDir}/cmake/toolchains/aarch64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "ALLOW_NON_PIXI_TOOLCHAIN": "ON",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "cross-riscv64",
      "inherits": "base",
      "displayName": "Cross-Compile Linux RISC-V 64 (RVA23)",
      "description": "Cross-compile Linux RISC-V RVA23 release artifacts with RVV 1.0 probing",
      "toolchainFile": "${fileDir}/cmake/toolchains/riscv64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "ALLOW_NON_PIXI_TOOLCHAIN": "ON",
        "ENABLE_CLANG_TIDY": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "displayName": "Build Developer Debug (ASan + UBSan + clang-tidy)",
      "description": "Build targets for configure preset ${configurePresetName}"
    },
    {
      "name": "ci-debug",
      "configurePreset": "ci-debug",
      "displayName": "Build CI Debug (ASan + UBSan, no clang-tidy)",
      "description": "Build targets for configure preset ${configurePresetName}"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "displayName": "Build Developer Release (Optimized, LTO, SPDX SBOM)",
