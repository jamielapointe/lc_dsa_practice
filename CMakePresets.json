{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 3
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{CONDA_PREFIX}/bin/clang",
        "CMAKE_CXX_COMPILER": "$env{CONDA_PREFIX}/bin/clang++",
        "CMAKE_PREFIX_PATH": "$env{CONDA_PREFIX}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "dev-debug",
      "inherits": "base",
      "displayName": "Developer Debug (ASan + UBSan + clang-tidy)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "ENABLE_SANITIZER_UNDEFINED": "ON",
        "ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "dev-release",
      "inherits": "base",
      "displayName": "Developer Release (Optimized, LTO)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_IPO": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "AddressSanitizer (ASan)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZER_ADDRESS": "ON"
      }
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "displayName": "UndefinedBehaviorSanitizer (UBSan)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZER_UNDEFINED": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer (TSan)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZER_THREAD": "ON"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "LLVM Source-Based Coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "displayName": "Build Developer Debug (ASan + UBSan + clang-tidy)"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "displayName": "Build Developer Release (Optimized, LTO)"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "displayName": "Build AddressSanitizer (ASan)"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "displayName": "Build UndefinedBehaviorSanitizer (UBSan)"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "displayName": "Build ThreadSanitizer (TSan)"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "displayName": "Build LLVM Source-Based Coverage"
    }
  ],
  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "displayName": "Run Tests (Developer Debug (ASan + UBSan + clang-tidy))",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "displayName": "Run Tests (Developer Release (Optimized, LTO))",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "displayName": "Run Tests (AddressSanitizer (ASan))",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "displayName": "Run Tests (UndefinedBehaviorSanitizer (UBSan))",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "displayName": "Run Tests (ThreadSanitizer (TSan))",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "name": "^(NumberOfIslandsTest\\.MaxConstraintsGrid|LruCacheTest\\.StressTest)$"
        }
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "displayName": "Run Tests (LLVM Source-Based Coverage)",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "LLVM_PROFILE_FILE": "${sourceDir}/build/coverage/profraw/%p-%m.profraw"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev-debug",
      "displayName": "Developer Debug (ASan + UBSan + clang-tidy) Workflow (Configure, Build, Test)",
      "steps": [
        {
          "type": "configure",
          "name": "dev-debug"
        },
        {
          "type": "build",
          "name": "dev-debug"
        },
        {
          "type": "test",
          "name": "dev-debug"
        }
      ]
    },
    {
      "name": "dev-release",
      "displayName": "Developer Release (Optimized, LTO) Workflow (Configure, Build, Test)",
      "steps": [
        {
          "type": "configure",
          "name": "dev-release"
        },
        {
          "type": "build",
          "name": "dev-release"
        },
        {
          "type": "test",
          "name": "dev-release"
        }
      ]
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer (ASan) Workflow (Configure, Build, Test)",
      "steps": [
        {
          "type": "configure",
          "name": "asan"
        },
        {
          "type": "build",
          "name": "asan"
        },
        {
          "type": "test",
          "name": "asan"
        }
      ]
    },
    {
      "name": "ubsan",
      "displayName": "UndefinedBehaviorSanitizer (UBSan) Workflow (Configure, Build, Test)",
      "steps": [
        {
          "type": "configure",
          "name": "ubsan"
        },
        {
          "type": "build",
          "name": "ubsan"
        },
        {
          "type": "test",
          "name": "ubsan"
        }
      ]
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer (TSan) Workflow (Configure, Build, Test)",
      "steps": [
        {
          "type": "configure",
          "name": "tsan"
        },
        {
          "type": "build",
          "name": "tsan"
        },
        {
          "type": "test",
          "name": "tsan"
        }
      ]
    },
    {
      "name": "coverage",
      "displayName": "LLVM Source-Based Coverage Workflow (Configure, Build, Test)",
      "steps": [
        {
          "type": "configure",
          "name": "coverage"
        },
        {
          "type": "build",
          "name": "coverage"
        },
        {
          "type": "test",
          "name": "coverage"
        }
      ]
    }
  ]
}
