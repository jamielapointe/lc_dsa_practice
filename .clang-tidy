---
# .clang-tidy
# Static analysis configuration for C++23 LeetCode DSA Practice Project
# Configured for Google Style Guide compatibility across LLVM Clang 23.1 and Apple Clang 21.0,
# while maintaining a pragmatic, low-noise environment for DSA practice.

Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  google-*,
  modernize-*,
  performance-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-narrowing-conversions,
  -google-build-using-namespace,
  -google-readability-todo,
  -google-runtime-int,
  -modernize-avoid-c-arrays,
  -modernize-use-nodiscard,
  -modernize-use-trailing-return-type,
  -readability-braces-around-statements,
  -readability-identifier-length,
  -readability-isolate-declaration,
  -readability-magic-numbers

WarningsAsErrors: '*'
HeaderFilterRegex: '(src|include)/.*'
FormatStyle: file
...
