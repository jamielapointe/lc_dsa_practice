[package]
name = "{{EXERCISE_SLUG}}"
version = "0.1.0"
edition = "2024"
resolver = "3"
rust-version = "1.99.1"
publish = false

# Standalone workspace isolation: isolates exercise from root workspace
# so active red-phase todo!() stubs and failing tests do not break root CI.
[workspace]

[dependencies]
thiserror = { version = "2.0", default-features = false }
cxx = { version = "1.0", optional = true }
libc = { version = "0.2", optional = true }

[dev-dependencies]

[build-dependencies]
cxx-build = { version = "1.0", optional = true }
cc = { version = "1.2", optional = true }

[lints.rust]
unsafe_op_in_unsafe_fn = "deny"

[lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }
todo = "allow" # Permits red-phase todo!() stubs; audited during green-phase critique
