# ==============================================================================
# Git Ignore - C++23 LeetCode DSA Practice Project
# ==============================================================================

# Prerequisites & Object files
*.d
*.o
*.obj
*.lo
*.slo
*.gch
*.pch
*.ilk
*.pdb
*.dwo

# Libraries and Executables
*.so
*.so.*
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app

# Fortran modules
*.mod
*.smod

# CMake Build Directories & Generated Files
build/
Build/
build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/

# CMake User Presets (per Modern CMake standards, CMakeUserPresets.json is gitignored)
CMakeUserPresets.json

# C++ Package Managers / Dependencies
vcpkg_installed/
_deps/

# Caches & Clang Diagnostics
.cache/
*.orig
*.rej

# Python & uv Environment
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Teamwork Agent Working Directory
.agents/teamwork/**

# Operating System & IDE Metadata
.DS_Store
._*
.vscode/
.idea/
*.swp
*.swo
*.bak
*.tmp
*.log
*~
